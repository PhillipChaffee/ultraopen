{
  "name": "ultraopen",
  "version": "0.1.0",
  "description": "Deterministic multi-agent workflow orchestration and an ultracode effort mode for opencode",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "opencode": ">=1.18.20"
  },
  "dependencies": {
    "acorn": "8.15.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.20",
    "@opencode-ai/sdk": "^1.18.20",
    "@opentui/core": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "lint": "oxlint --config .oxlintrc.json",
    "lint:fix": "oxlint --config .oxlintrc.json --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 15000",
    "test:node": "node --test test/node/sandbox-parity.mjs",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:node",
    "m0": "node test/m0-smoke.mjs",
    "build": "bun run script/build.ts",
    "prepublishOnly": "bun run check && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "workflow",
    "agents",
    "orchestration",
    "ultracode"
  ],
  "peerDependencies": {
    "@opentui/core": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
