{
  "name": "ultraopen",
  "version": "0.2.0-next.1",
  "description": "Deterministic multi-agent workflow orchestration and an ultracode effort mode for opencode",
  "license": "MIT",
  "author": "Phillip Chaffee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhillipChaffee/ultraopen.git"
  },
  "homepage": "https://github.com/PhillipChaffee/ultraopen#readme",
  "bugs": "https://github.com/PhillipChaffee/ultraopen/issues",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/server.js"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "import": "./dist/rpc.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "opencode": ">=2.3.2 <3"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2",
    "acorn": "8.15.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.3.2",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.80.0",
    "solid-js": "1.9.17",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "lint": "oxlint --config .oxlintrc.json",
    "lint:fix": "oxlint --config .oxlintrc.json --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 15000",
    "test:node": "node --test test/node/sandbox-parity.mjs",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:node",
    "m0": "node test/m0-smoke.mjs",
    "build": "bun run script/build.ts",
    "prepublishOnly": "bun run check && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "workflow",
    "agents",
    "orchestration",
    "ultracode"
  ],
  "peerDependencies": {
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}